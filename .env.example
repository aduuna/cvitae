# Local development settings. Copy to .env (git-ignored): cp .env.example .env
ENV=local
AUTH_MODE=dev
DATABASE_URL=postgresql+psycopg://vitae:vitae@localhost:5432/vitae
RENDERER_URL=http://localhost:8001
STORAGE_MODE=local
RENDERER_AUTH=none
# AI providers (optional locally; a provider without a key is not offered). Get API keys at
# https://platform.claude.com/settings/keys, https://aistudio.google.com/apikey and
# https://platform.xiaomimimo.com.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MIMO_API_KEY=
# Pro models need the Pro plan; set to false to try them locally without paying.
# ENFORCE_AI_PLANS=false
# Or put every local user on Pro, with its models and limits (needs AUTH_MODE=dev).
# DEV_PLAN=pro
# Billing with Paystack test mode (optional; upgrades are offered only when all three are set).
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PRO_PLAN_CODE=PLN_...
# PAYSTACK_CALLBACK_URL=http://localhost:5173/app/settings?tab=billing
