{
	"name": "extension",
	"private": true,
	"version": "0.1.1",
	"type": "module",
	"packageManager": "bun@1.3.9",
	"scripts": {
		"build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
		"package": "node --disable-warning=ExperimentalWarning scripts/package.ts",
		"store:assets": "playwright test --config playwright.store.config.ts",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"lint:firefox": "bunx web-ext@8 lint --source-dir dist/firefox",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.55.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/chrome": "^0.3.5",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"openapi-fetch": "0.17.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
